@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "PESCAPP";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PESCAPP | Comercialización pesquera</title>

    <style>
        :root {
            --azul: #103b50;
            --azul-oscuro: #092c3e;
            --turquesa: #159b91;
            --arena: #f5f3ed;
            --texto: #243746;
            --blanco: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: var(--texto);
            background: var(--arena);
        }

        header {
            background: var(--blanco);
            padding: 18px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            box-shadow: 0 3px 15px rgba(0,0,0,.06);
        }

        .logo {
            font-size: 27px;
            font-weight: 800;
            color: var(--azul);
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--turquesa);
        }

        nav {
            display: flex;
            gap: 27px;
            flex-wrap: wrap;
        }

        nav a {
            text-decoration: none;
            color: var(--azul);
            font-weight: 600;
            font-size: 14px;
        }

        nav a:hover {
            color: var(--turquesa);
        }

        .hero {
            min-height: 440px;
            padding: 75px 8%;
            display: flex;
            align-items: center;
            background: linear-gradient(115deg, #092c3e, #126477);
            color: white;
        }

        .hero-content {
            max-width: 700px;
        }

        .tag {
            display: inline-block;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.25);
            padding: 9px 15px;
            border-radius: 30px;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-size: clamp(36px, 5vw, 55px);
            line-height: 1.12;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #69d6c8;
        }

        .hero p {
            max-width: 590px;
            font-size: 17px;
            line-height: 1.7;
            color: #e1eff1;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 23px;
            background: var(--turquesa);
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            transition: .2s;
        }

        .btn:hover {
            background: #117d76;
            transform: translateY(-2px);
        }

        .section {
            padding: 65px 8%;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 35px;
        }

        .section-heading h2 {
            color: var(--azul);
            font-size: 31px;
            margin-bottom: 12px;
        }

        .section-heading p {
            color: #687984;
            line-height: 1.6;
        }

        .search-box {
            max-width: 650px;
            margin: 0 auto 35px;
            display: flex;
            background: white;
            padding: 7px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 13px;
            font-size: 15px;
        }

        .catalog {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 23px;
        }

        .product-card {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,.06);
            transition: .2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            height: 170px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 75px;
            background: linear-gradient(135deg, #d7f0ec, #b7dedc);
        }

        .product-info {
            padding: 22px;
        }

        .product-info small {
            color: var(--turquesa);
            font-weight: 700;
        }

        .product-info h3 {
            color: var(--azul);
            margin: 10px 0;
            font-size: 20px;
        }

        .product-info p {
            color: #687984;
            line-height: 1.5;
            font-size: 14px;
        }

        .demo-label {
            display: inline-block;
            margin-top: 15px;
            background: #f1f4f3;
            color: #536b70;
            padding: 7px 10px;
            border-radius: 5px;
            font-size: 12px;
        }

        #noResults {
            display: none;
            text-align: center;
            padding: 25px;
            color: #687984;
        }

        .about {
            background: white;
        }

        .about-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about-content p {
            font-size: 16px;
            line-height: 1.9;
            color: #5b6b74;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 35px;
        }

        .feature {
            background: var(--arena);
            border-radius: 12px;
            padding: 25px 18px;
        }

        .feature .emoji {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .feature h3 {
            color: var(--azul);
            margin-bottom: 9px;
        }

        .feature p {
            font-size: 14px;
            line-height: 1.6;
        }

        footer {
            background: var(--azul-oscuro);
            color: white;
            text-align: center;
            padding: 30px 15px;
            line-height: 1.8;
        }

        footer strong {
            color: #69d6c8;
        }

        @@media (max-width: 800px) {
            .catalog, .features {
                grid-template-columns: 1fr 1fr;
            }

            .hero {
                padding: 60px 7%;
            }
        }

        @@media (max-width: 550px) {
            header {
                justify-content: center;
            }

            nav {
                justify-content: center;
                gap: 15px;
            }

            .catalog, .features {
                grid-template-columns: 1fr;
            }

            .search-box {
                flex-direction: column;
            }

            .search-box input {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">PES<span>CAPP</span></div>

        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#productos">Productos</a>
            <a href="#nosotros">Sobre el proyecto</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </header>

    <main>
        <section class="hero" id="inicio">
            <div class="hero-content">
                <div class="tag">Mosquera · Nariño · Colombia</div>

                <h1>
                    Conectando la pesca artesanal con
                    <span>nuevas oportunidades.</span>
                </h1>

                <p>
                    PESCAPP es una propuesta de plataforma web que busca
                    facilitar la consulta y comercialización de productos
                    pesqueros, conectando a vendedores y compradores mediante
                    información organizada y accesible.
                </p>

                <a href="#productos" class="btn">Explorar productos</a>
            </div>
        </section>

        <section class="section" id="productos">
            <div class="section-heading">
                <h2>Productos pesqueros</h2>
                <p>
                    Consulta ejemplos de cómo se visualizará la información
                    de los productos disponibles en la plataforma.
                </p>
            </div>

            <div class="search-box">
                <input type="text" id="productSearch"
                       placeholder="Buscar un producto..." />
            </div>

            <div class="catalog">
                <article class="product-card" data-search="pescado fresco pescado">
                    <div class="product-image">🐟</div>
                    <div class="product-info">
                        <small>PRODUCTO DE EJEMPLO</small>
                        <h3>Pescado fresco</h3>
                        <p>
                            Espacio para consultar las características,
                            cantidad disponible, precio y procedencia básica.
                        </p>
                        <span class="demo-label">Contenido de demostración</span>
                    </div>
                </article>

                <article class="product-card" data-search="camarón mariscos">
                    <div class="product-image">🦐</div>
                    <div class="product-info">
                        <small>PRODUCTO DE EJEMPLO</small>
                        <h3>Camarón</h3>
                        <p>
                            Información del producto y datos de contacto
                            del vendedor cuando se registre una publicación.
                        </p>
                        <span class="demo-label">Contenido de demostración</span>
                    </div>
                </article>

                <article class="product-card" data-search="producto temporada pesquero">
                    <div class="product-image">🦪</div>
                    <div class="product-info">
                        <small>PRODUCTO DE EJEMPLO</small>
                        <h3>Producto de temporada</h3>
                        <p>
                            Espacio para mostrar disponibilidad, precio
                            y características básicas del producto.
                        </p>
                        <span class="demo-label">Contenido de demostración</span>
                    </div>
                </article>
            </div>

            <p id="noResults">No se encontraron productos con esa búsqueda.</p>
        </section>

        <section class="section about" id="nosotros">
            <div class="about-content">
                <div class="section-heading">
                    <h2>¿Qué es PESCAPP?</h2>
                </div>

                <p>
                    PESCAPP es una propuesta tecnológica orientada a apoyar
                    la comercialización sostenible de productos pesqueros
                    en Mosquera, Nariño. Su propósito es organizar la
                    información de los productos, facilitar su consulta
                    y ofrecer canales de contacto entre pescadores
                    y posibles compradores.
                </p>

                <div class="features">
                    <div class="feature">
                        <div class="emoji">📋</div>
                        <h3>Información organizada</h3>
                        <p>
                            Registro de características, cantidades,
                            precios y disponibilidad de los productos.
                        </p>
                    </div>

                    <div class="feature">
                        <div class="emoji">🔎</div>
                        <h3>Consulta sencilla</h3>
                        <p>
                            Búsqueda de productos y consulta de información
                            desde una plataforma web.
                        </p>
                    </div>

                    <div class="feature">
                        <div class="emoji">🤝</div>
                        <h3>Conexión comercial</h3>
                        <p>
                            Canales de contacto para facilitar la comunicación
                            entre vendedores y compradores.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer id="contacto">
        <strong>PESCAPP</strong>
        <p>Plataforma web para apoyar la comercialización sostenible de productos pesqueros.</p>
        <p>Mosquera, Nariño - Colombia</p>
        <p>Proyecto académico | 2026</p>
    </footer>

    <script>
        const searchInput = document.getElementById("productSearch");
        const cards = document.querySelectorAll(".product-card");
        const noResults = document.getElementById("noResults");

        searchInput.addEventListener("input", function () {
            const search = this.value.toLowerCase().trim();
            let visibleCards = 0;

            cards.forEach(function (card) {
                const content = card.dataset.search.toLowerCase();
                const matches = content.includes(search);

                card.style.display = matches ? "block" : "none";

                if (matches) {
                    visibleCards++;
                }
            });

            noResults.style.display = visibleCards === 0 ? "block" : "none";
        });
    </script>

</body>
</html>
