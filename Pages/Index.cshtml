@page
@model IndexModel
@inject Microsoft.AspNetCore.Identity.UserManager<PESCAPP.Models.ApplicationUser> UserManager
@{
    Layout = null;
    ViewData["Title"] = "PESCAPP";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PESCAPP | Comercialización pesquera</title>

    <style>
        :root {
            --azul: #103b50;
            --azul-oscuro: #092c3e;
            --turquesa: #159b91;
            --arena: #f5f3ed;
            --texto: #243746;
            --blanco: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: var(--texto);
            background: var(--arena);
        }

        header {
            background: var(--blanco);
            padding: 18px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            box-shadow: 0 3px 15px rgba(0,0,0,.06);
        }

        .logo {
            font-size: 27px;
            font-weight: 800;
            color: var(--azul);
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--turquesa);
        }

        nav {
            display: flex;
            gap: 27px;
            flex-wrap: wrap;
        }

        nav a {
            text-decoration: none;
            color: var(--azul);
            font-weight: 600;
            font-size: 14px;
        }

        nav a:hover {
            color: var(--turquesa);
        }

        .hero {
            min-height: 440px;
            padding: 75px 8%;
            display: flex;
            align-items: center;
            background-image: linear-gradient(rgba(3, 39, 57, 0.55), rgba(3, 39, 57, 0.65)), url('/images/pescapp-banner.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: white;
        }

        .hero-content {
            max-width: 700px;
        }

        .tag {
            display: inline-block;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.25);
            padding: 9px 15px;
            border-radius: 30px;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-size: clamp(36px, 5vw, 55px);
            line-height: 1.12;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #69d6c8;
        }

        .hero p {
            max-width: 590px;
            font-size: 17px;
            line-height: 1.7;
            color: #e1eff1;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 23px;
            background: var(--turquesa);
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            transition: .2s;
        }

        .btn:hover {
            background: #117d76;
            transform: translateY(-2px);
        }

        .section {
            padding: 65px 8%;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 35px;
        }

        .section-heading h2 {
            color: var(--azul);
            font-size: 31px;
            margin-bottom: 12px;
        }

        .section-heading p {
            color: #687984;
            line-height: 1.6;
        }

        .search-box {
            max-width: 650px;
            margin: 0 auto 35px;
            display: flex;
            background: white;
            padding: 7px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 13px;
            font-size: 15px;
        }

        .catalog {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 28px;
            align-items: stretch;
        }

        .product-card {
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 6px 22px rgba(0, 45, 65, 0.10);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #e5eff2;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 28px rgba(0, 45, 65, 0.16);
            }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            height: 190px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 82px;
            background: linear-gradient(135deg, #e5f5f3, #c5e5e2);
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.03);
        }

        .product-info {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .product-info small {
            color: var(--turquesa);
            font-weight: 700;
        }

            .product-info h3 {
                color: var(--azul);
                margin: 5px 0;
                font-size: 21px;
                font-weight: 700;
                line-height: 1.4;
            }

            .product-info p {
                color: #687984;
                line-height: 1.7;
                font-size: 14px;
                margin: 4px 0;
            }

        .product-price {
            color: #087f8c;
            font-size: 22px;
            font-weight: 800;
            margin-top: 8px;
        }

        .product-quantity {
            color: #087f8c;
            font-weight: 700;
            font-size: 16px;
        }

        .product-category {
            display: inline-block;
            background: #e0f3f1;
            color: #087f8c;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            width: fit-content;
        }


        .demo-label {
            display: inline-block;
            margin-top: 15px;
            background: #f1f4f3;
            color: #536b70;
            padding: 7px 10px;
            border-radius: 5px;
            font-size: 12px;
        }

        #noResults {
            display: none;
            text-align: center;
            padding: 25px;
            color: #687984;
        }

        .about {
            background: white;
        }

        .about-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about-content p {
            font-size: 16px;
            line-height: 1.9;
            color: #5b6b74;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 35px;
        }

        .feature {
            background: var(--arena);
            border-radius: 12px;
            padding: 25px 18px;
        }

        .feature .emoji {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .feature h3 {
            color: var(--azul);
            margin-bottom: 9px;
        }

        .feature p {
            font-size: 14px;
            line-height: 1.6;
        }

        footer {
            background: var(--azul-oscuro);
            color: white;
            text-align: center;
            padding: 30px 15px;
            line-height: 1.8;
        }

        footer strong {
            color: #69d6c8;
        }

        @@media (max-width: 800px) {
            .catalog, .features {
                grid-template-columns: 1fr 1fr;
            }

            .hero {
                padding: 60px 7%;
            }
        }

        @@media (max-width: 550px) {
            header {
                justify-content: center;
            }

            nav {
                justify-content: center;
                gap: 15px;
            }

            .catalog, .features {
                grid-template-columns: 1fr;
            }

            .search-box {
                flex-direction: column;
            }

            .search-box input {
                width: 100%;

            } 
            
        }

        .decoracion-marina {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    margin-bottom: 25px;
    font-size: 42px;
    animation: aparecer 1s ease-in-out;
}

.decoracion-marina span:nth-child(even) {
    font-size: 52px;
}

.mensaje-bienvenida {
    color: #e4f5f7;
    font-size: 17px;
    line-height: 1.7;
    max-width: 650px;
    margin: 20px auto;
    text-align: center;
}

        @@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}


    </style>
</head>

<body>

    <header>
        <div class="logo">PES<span>CAPP</span></div>

        <nav>
            <a href="#inicio">Inicio</a>
            <a href="/Producto/Listado">Productos</a>
            <a href="#nosotros">Sobre el proyecto</a>
            <a href="#contacto">Contacto</a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var currentUser = await UserManager.GetUserAsync(User);

                @if (currentUser != null && currentUser.UserType == "Administrador")
                {
                    <a href="/Administracion">Administración</a>
                }
                @if (currentUser != null && currentUser.UserType == "Vendedor")
                {
                    <a href="/Producto/Crear">Publicar producto</a>
                    <a href="/Producto/Listado">Mis productos</a>
                }

                <span>
                    Hola, @(currentUser != null && !string.IsNullOrEmpty(currentUser.FullName)
                  ? currentUser.FullName
                  : User.Identity.Name)
                </span>
                <a href="/Perfil">Mi perfil</a>

                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="/" method="post">
                    <button type="submit">Cerrar sesión</button>
                </form>
            }
            else
            {
                <a href="/Identity/Account/Register">Registrarse</a>
                <a href="/Identity/Account/Login">Iniciar sesión</a>
            }
        </nav>
    </header>

    <main>
        <section class="hero" id="inicio">
            <div class="hero-content">
                <div class="tag">Mosquera · Nariño · Colombia</div>


                <h1>
                    Conectando la pesca artesanal con
                    <span>nuevas oportunidades.</span>
                </h1>

                <a href="#productos" class="btn">Explorar productos</a>
            </div>
        </section>

        <section class="section" id="productos">
            <div class="section-heading">
                <h2>Productos pesqueros</h2>
                <p>
                    Consulta ejemplos de cómo se visualizará la información
                    de los productos disponibles en la plataforma.
                </p>
            </div>

            <div class="search-box">
                <input type="text" id="productSearch"
                       placeholder="Buscar un producto..." />
            </div>

            <div class="catalog">
                @if (Model.Productos.Any())
                {
                    @foreach (var producto in Model.Productos)
                    {
                        <article class="product-card"
                                 data-search="@($"{producto.Nombre} {producto.Categoria} {producto.Descripcion}")">
                            <div class="product-image">
                                @if (producto.Nombre.Contains("camarón", StringComparison.OrdinalIgnoreCase) ||
                               producto.Nombre.Contains("camaron", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>🦐</span>
                                }
                                else if (producto.Nombre.Contains("pargo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>🐠</span>
                                }
                                else if (producto.Nombre.Contains("cangrejo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>🦀</span>
                                }
                                else if (producto.Nombre.Contains("pulpo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>🐙</span>
                                }
                                else
                                {
                                    <span>🐟</span>
                                }
                            </div>

                            <div class="product-info">
                                <span class="product-category">@producto.Categoria</span>

                                <h3>@producto.Nombre</h3>

                                <p>@producto.Descripcion</p>

                                <p>
                                    <strong>Cantidad disponible:</strong>
                                    <span class="product-quantity">
                                        @producto.CantidadDisponible.ToString("0.##")
                                    </span>
                                </p>

                                <p>
                                    <strong>Precio:</strong>
                                    <span class="product-price">
                                        $@producto.Precio.ToString("N0")
                                    </span>
                                </p>

                                <p>
                                    <strong>Procedencia:</strong>
                                    @producto.Procedencia
                                </p>

                                <p>
                                    <strong>Vendedor:</strong>
                                    @(producto.Vendedor?.FullName ?? "No disponible")
                                </p>

                                <p>
                                    <strong>Contacto:</strong>
                                    @(producto.Vendedor?.PhoneNumber ?? "No disponible")
                                </p>

                                <span class="demo-label">Producto publicado</span>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <p>No hay productos disponibles en este momento.</p>
                }
            </div>

            <p id="noResults">No se encontraron productos con esa búsqueda.</p>
        </section>

        <section class="section about" id="nosotros">
            <div class="about-content">
                <div class="section-heading">
                    <h2>¿Qué es PESCAPP?</h2>
                </div>

                <p>
                    PESCAPP es una propuesta tecnológica orientada a apoyar
                    la comercialización sostenible de productos pesqueros
                    en Mosquera, Nariño. Su propósito es organizar la
                    información de los productos, facilitar su consulta
                    y ofrecer canales de contacto entre pescadores
                    y posibles compradores.
                </p>

                <div class="features">
                    <div class="feature">
                        <div class="emoji">📋</div>
                        <h3>Información organizada</h3>
                        <p>
                            Registro de características, cantidades,
                            precios y disponibilidad de los productos.
                        </p>
                    </div>

                    <div class="feature">
                        <div class="emoji">🔎</div>
                        <h3>Consulta sencilla</h3>
                        <p>
                            Búsqueda de productos y consulta de información
                            desde una plataforma web.
                        </p>
                    </div>

                    <div class="feature">
                        <div class="emoji">🤝</div>
                        <h3>Conexión comercial</h3>
                        <p>
                            Canales de contacto para facilitar la comunicación
                            entre vendedores y compradores.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer id="contacto">
        <strong>PESCAPP</strong>
        <p>Plataforma web para apoyar la comercialización sostenible de productos pesqueros.</p>
        <p>Mosquera, Nariño - Colombia</p>
        <p>Proyecto académico | 2026</p>
    </footer>

    <script>
        const searchInput = document.getElementById("productSearch");
        const cards = document.querySelectorAll(".product-card");
        const noResults = document.getElementById("noResults");

        searchInput.addEventListener("input", function () {
            const search = this.value.toLowerCase().trim();
            let visibleCards = 0;

            cards.forEach(function (card) {
                const content = card.dataset.search.toLowerCase();
                const matches = content.includes(search);

                card.style.display = matches ? "block" : "none";

                if (matches) {
                    visibleCards++;
                }
            });

            noResults.style.display = visibleCards === 0 ? "block" : "none";
        });
    </script>

</body>
</html>
