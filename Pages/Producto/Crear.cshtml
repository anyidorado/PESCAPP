@page
@model PESCAPP.Pages.Producto.CrearModel

@{
    ViewData["Title"] = "Publicar producto";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Publicar producto | PESCAPP</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f0f7fa;
            color: #183b50;
        }

        header {
            background: linear-gradient(120deg, #073b55, #087e91);
            padding: 22px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            color: white;
        }

        .logo {
            font-size: 27px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        header a {
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        .contenedor {
            max-width: 850px;
            margin: 45px auto;
            padding: 0 20px;
        }

        .encabezado {
            text-align: center;
            margin-bottom: 28px;
        }

        .encabezado h1 {
            color: #07516b;
            font-size: 30px;
            margin-bottom: 10px;
        }

        .encabezado p {
            color: #607b89;
            line-height: 1.6;
        }

        .tarjeta {
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(13, 64, 83, 0.10);
            border: 1px solid #dcebf0;
        }

        .campo {
            margin-bottom: 21px;
        }

        label {
            display: block;
            font-weight: 650;
            margin-bottom: 8px;
            color: #16475e;
        }

        input, textarea {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #cbdde5;
            border-radius: 9px;
            font-size: 15px;
            font-family: inherit;
            background: #fbfdfe;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #07899b;
            box-shadow: 0 0 0 3px rgba(7, 137, 155, 0.12);
        }

        textarea {
            resize: vertical;
        }

        .ayuda {
            color: #718995;
            font-size: 12px;
            margin-top: 5px;
        }

        .error {
            color: #c0392b;
            font-size: 13px;
        }

        .botones {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .boton {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 9px;
            border: none;
            text-decoration: none;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
        }

        .principal {
            background: #087e91;
            color: white;
        }

        .principal:hover {
            background: #065f73;
        }

        .secundario {
            background: #e7f0f4;
            color: #24536a;
        }

        footer {
            text-align: center;
            color: #78909c;
            padding: 25px;
            font-size: 13px;
        }

        @@media (max-width: 600px) {
            .tarjeta {
                padding: 23px 18px;
            }

            .encabezado h1 {
                font-size: 25px;
            }

            .botones {
                flex-direction: column;
            }

            .boton {
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">PESCAPP</div>
        <a href="/">← Volver al inicio</a>
    </header>

    <main class="contenedor">

        <section class="encabezado">
            <h1>Publicar producto pesquero</h1>
            <p>
                Comparte la información de tus productos pesqueros
                y permite que más compradores conozcan tu oferta.
            </p>
        </section>

        <section class="tarjeta">

            <form method="post">

                <div class="campo">
                    <label asp-for="Producto.Nombre">Nombre del producto</label>
                    <input asp-for="Producto.Nombre"
                           placeholder="Ej. Pargo rojo" />
                    <span asp-validation-for="Producto.Nombre" class="error"></span>
                </div>

                <div class="campo">
                    <label asp-for="Producto.Categoria">Categoría</label>
                    <input asp-for="Producto.Categoria"
                           placeholder="Ej. Pescado, camarón" />
                    <span asp-validation-for="Producto.Categoria" class="error"></span>
                </div>

                <div class="campo">
                    <label asp-for="Producto.Descripcion">Descripción</label>
                    <textarea asp-for="Producto.Descripcion"
                              rows="3"
                              placeholder="Describe las características del producto"></textarea>
                </div>

                <div class="campo">
                    <label asp-for="Producto.CantidadDisponible">Cantidad disponible</label>
                    <input asp-for="Producto.CantidadDisponible"
                           type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Producto.CantidadDisponible" class="error"></span>
                    <div class="ayuda">Indica la cantidad disponible para consulta.</div>
                </div>

                <div class="campo">
                    <label asp-for="Producto.Precio">Precio por unidad (COP)</label>
                    <input asp-for="Producto.Precio"
                           type="number" step="0.01" min="0.01"
                           placeholder="Ej. 25000" />
                    <span asp-validation-for="Producto.Precio" class="error"></span>
                </div>

                <div class="campo">
                    <label asp-for="Producto.Procedencia">Procedencia</label>
                    <input asp-for="Producto.Procedencia"
                           placeholder="Lugar de origen del producto" />
                </div>

                <div class="campo">
                    <label asp-for="Producto.Observaciones">Observaciones</label>
                    <textarea asp-for="Producto.Observaciones"
                              rows="3"
                              placeholder="Información adicional sobre el producto"></textarea>
                </div>

                <div class="botones">
                    <button type="submit" class="boton principal">
                        Publicar producto
                    </button>

                    <a href="/" class="boton secundario">
                        Cancelar
                    </a>
                </div>

            </form>

        </section>

    </main>

    <footer>
        PESCAPP © 2026 | Conectando la pesca artesanal con nuevas oportunidades.
    </footer>

</body>
</html>
